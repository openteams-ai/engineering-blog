# Copy to .env for `npm run ga:report`. Never commit .env.
# Numeric GA4 property ID: GA4 Admin > Property details (not the G- measurement ID).
GA_PROPERTY_ID=
# Optional: a service account's JSON key on one line, with Viewer access on the
# property. Leave empty to use `gcloud auth application-default login` instead.
GA_SERVICE_ACCOUNT_JSON=
# For `npm run traffic:alert`: a Slack incoming webhook. Empty prints the alert instead.
SLACK_TRAFFIC_WEBHOOK=
