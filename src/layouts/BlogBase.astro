---
import { Font } from "astro:assets";
import { Icon } from "astro-iconset/components";
import DarbySearch from "../components/DarbySearch.astro";
import MainSiteHeader from "../components/MainSiteHeader.astro";
import { ANALYTICS_ID, SITE_TAGLINE, SITE_TITLE, TITLE_ENDING, footerColumns, socialLinks } from "../data/site";
import { blogUrl, pageUrl } from "../lib/blog-path";
import { ogCards, ogFile } from "../lib/og-cards";
import { getPosts, type Author } from "../lib/posts";
import { pageSchema } from "../lib/schema";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	/** Share card key (lib/og-cards.ts); pages without a card use the blog's. */
	og?: string;
	type?: "website" | "article";
	/** Set on a post: its date and authors, for search engines. */
	article?: { published: Date; authors: Author[] };
}

const { title, description, og = "home", type = "website", article } = Astro.props;
const fullTitle = title ? `${title} | ${TITLE_ENDING}` : TITLE_ENDING;
const pageDescription = description || SITE_TAGLINE;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const cards = ogCards(await getPosts());
const card = cards.find((c) => c.key === og) ?? cards[0];
const ogImage = new URL(blogUrl(ogFile(card)), Astro.site).href;
// "<" is escaped so no text in the data can close the script element early.
const schema = JSON.stringify(
	pageSchema({
		url: canonical,
		article: article && {
			title: title ?? "",
			description: pageDescription,
			published: article.published,
			image: ogImage,
			authors: article.authors.map((author) => ({
				name: author.name,
				bio: author.bio,
				url: new URL(pageUrl(`/author/${author.slug}`), Astro.site).href,
				sameAs: Object.values(author.links ?? {}),
			})),
		},
	}),
).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en" class="blog-theme">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<meta name="description" content={pageDescription} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:title" content={title ?? SITE_TITLE} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		{article && <meta property="article:published_time" content={article.published.toISOString()} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<link rel="alternate" type="application/rss+xml" title="OpenTeams Engineering Blog" href={blogUrl("/rss.xml")} />
		<link rel="icon" type="image/png" href={blogUrl("/favicon.png")} />
		<script is:inline type="application/ld+json" set:html={schema} />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-post" preload />
		<Font cssVariable="--font-mono" />
		{/* Google Analytics: built pages only, so local development is not counted. */}
		{import.meta.env.PROD && (
			<>
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS_ID}`}></script>
				<script is:inline define:vars={{ ANALYTICS_ID }}>
					window.dataLayer = window.dataLayer || [];
					function gtag() {
						dataLayer.push(arguments);
					}
					gtag("js", new Date());
					gtag("config", ANALYTICS_ID);
				</script>
			</>
		)}
		<slot name="head" />
		<style is:global>
			/* Moon/sun toggle icon follows the effective theme. */
			.theme-icon-sun { display: none; }
			html.dark .theme-icon-sun { display: block; }
			html.dark .theme-icon-moon { display: none; }
			@media (prefers-color-scheme: dark) {
				html:not(.light) .theme-icon-sun { display: block; }
				html:not(.light) .theme-icon-moon { display: none; }
			}
		</style>
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
	</head>
	<body class="min-h-screen leading-relaxed">
		<MainSiteHeader>
			<DarbySearch />
			<button
				type="button"
				id="theme-toggle"
				class="flex size-9 cursor-pointer items-center justify-center rounded-full border border-white/20 text-lg text-white/75 transition-colors hover:border-[#4d75fe] hover:text-white"
				aria-label="Toggle dark mode"
			>
				<Icon name="ph:moon" class="theme-icon-moon" aria-hidden="true" />
				<Icon name="ph:sun" class="theme-icon-sun" aria-hidden="true" />
			</button>
		</MainSiteHeader>

		<main class="min-h-[calc(100vh-200px)]">
			<slot />
		</main>

		<footer class="bg-deep text-[#8d99bd]">
			<div class="container-wide grid grid-cols-1 gap-12 py-16 md:grid-cols-[1.4fr_2fr] md:gap-20">
				<div>
					<img src={blogUrl("/openteams-white-horizontal.png")} alt={SITE_TITLE} class="h-7 w-auto" />
					<p class="mt-4 max-w-xs text-sm leading-relaxed">{SITE_TAGLINE}</p>
					<div class="mt-5 flex flex-wrap gap-2">
						{socialLinks.map((s) => (
							<a
								href={s.url}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={s.label}
								title={s.label}
								class="flex size-9 items-center justify-center rounded-lg bg-white/5 text-lg text-[#cfd8ef] transition-colors hover:bg-white/10 hover:text-white"
							>
								<Icon name={s.icon} aria-hidden="true" />
							</a>
						))}
						<a
							href={blogUrl("/rss.xml")}
							aria-label="RSS feed"
							title="RSS"
							class="flex size-9 items-center justify-center rounded-lg bg-white/5 text-lg text-[#cfd8ef] transition-colors hover:bg-white/10 hover:text-white"
						>
							<Icon name="ph:rss" aria-hidden="true" />
						</a>
					</div>
				</div>
				<div class="grid grid-cols-2 gap-8 md:grid-cols-3">
					{footerColumns.map((col) => (
						<div>
							<h2 class="mb-4 text-xs font-semibold tracking-[0.08em] text-white uppercase">{col.heading}</h2>
							{col.links.map((link) => (
								<a href={link.url} class="block py-1.5 text-sm transition-colors hover:text-white">{link.label}</a>
							))}
						</div>
					))}
				</div>
			</div>
			<div class="container-wide border-t border-white/10 py-6 text-sm text-[#97a3c4]">
				<p>&copy; {new Date().getFullYear()} {SITE_TITLE}. All rights reserved.</p>
			</div>
		</footer>

		<script>
			// Single moon/sun toggle: flips between explicit light and dark,
			// starting from the effective theme (cookie, else OS preference).
			const root = document.documentElement;
			const toggle = document.getElementById("theme-toggle");

			function effectiveDark(): boolean {
				if (root.classList.contains("dark")) return true;
				if (root.classList.contains("light")) return false;
				return window.matchMedia("(prefers-color-scheme: dark)").matches;
			}

			toggle?.addEventListener("click", () => {
				const next = effectiveDark() ? "light" : "dark";
				const secure = location.protocol === "https:" ? "; Secure" : "";
				document.cookie = `theme=${next}; path=/; max-age=31536000; SameSite=Lax${secure}`;
				root.classList.remove("light", "dark");
				root.classList.add(next);
			});
		</script>
	</body>
</html>
