---
import Base from "../../layouts/BlogBase.astro";
import PostCard from "../../components/PostCard.astro";
import { blogUrl } from "../../lib/blog-path";
import { getPosts, topicsOf, type Post } from "../../lib/posts";

export async function getStaticPaths() {
	const posts = await getPosts();
	return topicsOf(posts).map((topic) => ({
		params: { slug: topic.slug },
		props: { label: topic.label, posts: posts.filter((p) => p.topic?.slug === topic.slug) },
	}));
}

const { label, posts } = Astro.props as { label: string; posts: Post[] };
---

<Base title={`${label} — Engineering Blog`}>
	<section class="container-wide pt-16 pb-10">
		<a href={blogUrl("/")} class="cat-label">&larr; Engineering Blog</a>
		<h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">{label}</h1>
		<p class="mt-3 text-lg text-muted">
			{posts.length} article{posts.length === 1 ? "" : "s"}
		</p>
	</section>
	<div class="container-wide grid gap-x-10 gap-y-11 pb-22 md:grid-cols-3">
		{posts.map((p) => <PostCard post={p} />)}
	</div>
</Base>
