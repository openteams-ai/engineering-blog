---
// Renders a 1200x630 share card (lib/og-cards.ts lists them). `npm run og`
// screenshots the cards the live site doesn't have yet into dist/.
// Dev only: production builds emit no card pages.
import { Font } from "astro:assets";
import { blogUrl } from "../../lib/blog-path";
import { getPosts } from "../../lib/posts";
import { ogCards } from "../../lib/og-cards";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

export async function getStaticPaths() {
	if (import.meta.env.PROD) return [];
	return ogCards(await getPosts()).map((card) => ({ params: { slug: card.key }, props: card }));
}

const { slug } = Astro.params;
const isHome = slug === "home";
const { title, byline, avatar } = Astro.props as { title: string; byline: string; avatar: string | null };

// Laid out for the full 1200x630 card that LinkedIn and X show: title on
// the left, the post's art on the right.
const titleSize = title.length > 70 ? 42 : title.length > 45 ? 48 : 54;

// The post's card art (components/art/<slug>.astro), when it has one.
// Author cards have none and center the photo, name and role instead.
const art = import.meta.glob<AstroComponentFactory>("../../components/art/*.astro", { eager: true, import: "default" });
const Art: AstroComponentFactory | undefined = art[`../../components/art/${slug}.astro`];

// "Names · 9 min read" stacks into two lines next to the photo.
const [bylineNames, ...bylineRest] = byline.split(" · ");

// Deterministic matmul cell intensities, same recipe as the hero splash.
const val = (m: number, i: number, j: number) =>
	0.25 + (((m * 31 + i * 17 + j * 7) % 13) / 13) * 0.7;
const grid = (m: number) =>
	Array.from({ length: 16 }, (_, k) => ({
		i: Math.floor(k / 4),
		j: k % 4,
		v: val(m, Math.floor(k / 4), k % 4),
	}));
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<Font cssVariable="--font-sora" preload />
		<Font cssVariable="--font-nav" preload />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" preload />
		<Font cssVariable="--font-post" preload />
	</head>
	<body>
		{isHome ? (
			<div class="card home">
				<svg class="matmul" width="560" height="200" viewBox="0 0 560 200" aria-hidden="true">
					{[0, 1].map((m) => (
						<g transform={`translate(${m * 190} 20)`}>
							{grid(m + 1).map((c) => (
								<rect
									x={c.j * 40}
									y={c.i * 40}
									width="32"
									height="32"
									rx="7"
									fill={m === 0 ? "#8aa2ff" : "#ff9d7e"}
									opacity={c.v * 0.55}
								/>
							))}
						</g>
					))}
					<text x="164" y="105" font-size="30" fill="#8aa2ff" opacity="0.7">&#215;</text>
					<text x="358" y="105" font-size="30" fill="#8aa2ff" opacity="0.7">=</text>
					<g transform="translate(392 20)">
						{grid(3).map((c) => (
							<rect
								x={c.j * 40}
								y={c.i * 40}
								width="32"
								height="32"
								rx="7"
								fill="#ffffff"
								opacity={c.v * 0.5}
							/>
						))}
					</g>
				</svg>
				<div class="home-center">
					<img class="home-logo" src={blogUrl("/openteams-white-horizontal.png")} alt="OpenTeams" />
					<div class="home-title">Engineering Blog</div>
				</div>
			</div>
		) : (
			<div class="card post">
				<div class="brand">
					<img class="logo" src={blogUrl("/openteams-horizontal.png")} alt="OpenTeams" />
					<span class="section">Engineering</span>
				</div>
				{Art ? (
					<>
						<div class="title-col"><div class="title left">{title}</div></div>
						<div class="art"><Art /></div>
						<div class="author">
							{avatar && <img class="avatar" src={avatar} alt="" />}
							<div class="byline">
								<span class="names">{bylineNames}</span>
								{bylineRest.length > 0 && <span class="meta">{bylineRest.join(" · ")}</span>}
							</div>
						</div>
					</>
				) : (
					<div class="center">
						{avatar && <img class="avatar large" src={avatar} alt="" />}
						<div class="title">{title}</div>
						<div class="byline centered">{byline}</div>
					</div>
				)}
				<div class="accent"></div>
			</div>
		)}
	</body>
</html>

<style define:vars={{ titleSize: `${titleSize}px` }}>
	.card {
		/* Padding counts inside the 1200x630 box, so the byline is not pushed
		   below the captured area. */
		box-sizing: border-box;
		position: fixed;
		top: 0;
		left: 0;
		width: 1200px;
		height: 630px;
		background: #041437;
		overflow: hidden;
		padding: 64px 80px;
		display: flex;
		flex-direction: column;
	}

	/* Post and author cards: white background. */
	.card.post {
		background: #ffffff;
		padding: 0;
	}

	/* "OpenTeams | Engineering", top left. */
	.brand {
		position: absolute;
		top: 44px;
		left: 64px;
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.logo {
		height: 40px;
		width: auto;
	}

	.section {
		border-left: 2px solid rgba(9, 30, 66, 0.2);
		padding-left: 20px;
		font-family: var(--font-body), ui-sans-serif, sans-serif;
		font-size: 26px;
		font-weight: 500;
		line-height: 36px;
		color: #44546f;
	}

	/* Post cards: title column between the brand row and the byline. */
	.title-col {
		position: absolute;
		top: 112px;
		bottom: 132px;
		left: 64px;
		width: 560px;
		display: flex;
		align-items: center;
	}

	.title.left {
		max-width: none;
		text-align: left;
	}

	/* Author cards: photo, name and role in a centered column. */
	.center {
		position: absolute;
		top: 104px;
		bottom: 40px;
		left: 285px;
		width: 630px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 28px;
	}

	.title {
		max-width: 600px;
		text-align: center;
		font-family: var(--font-sora), ui-sans-serif, sans-serif;
		font-size: var(--titleSize);
		line-height: 1.15;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #091e42;
	}

	/* Same 720x380 proportions as the art's viewBox, centered on the right. */
	.art {
		position: absolute;
		right: 64px;
		top: 187px;
		width: 486px;
		height: 256px;
		border-radius: 16px;
		overflow: hidden;
	}

	.art :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.author {
		position: absolute;
		left: 64px;
		bottom: 52px;
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.avatar {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		object-fit: cover;
	}

	/* Author cards have no art: photo, name and role centered. */
	.avatar.large {
		width: 140px;
		height: 140px;
	}

	.byline.centered {
		font-size: 28px;
		color: #5d6575;
	}

	.byline {
		display: flex;
		flex-direction: column;
		gap: 2px;
		font-family: var(--font-nav), ui-sans-serif, sans-serif;
		font-size: 22px;
		font-weight: 500;
	}

	.names {
		color: #091e42;
	}

	.meta {
		color: #5d6575;
	}

	/* Brand colors along the bottom edge. */
	.accent {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 12px;
		background: linear-gradient(90deg, #4d75fe 0 60%, #faa944 60% 80%, #ff8a69 80%);
	}

	/* Home card: centered lockup over a faint matrix-multiplication motif,
	   echoing the live hero animation. */
	.card.home {
		align-items: center;
		justify-content: center;
		padding: 0;
	}

	.matmul {
		position: absolute;
		right: 36px;
		bottom: 28px;
		opacity: 0.5;
	}

	.home-center {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 44px;
		transform: translateY(-26px);
	}

	.home-logo {
		height: 92px;
		width: auto;
	}

	.home-title {
		font-family: var(--font-sora), ui-sans-serif, sans-serif;
		font-size: 66px;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #8aa2ff;
	}
</style>
