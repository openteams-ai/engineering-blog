---
import Base from "../layouts/BlogBase.astro";
import BlogThumb from "../components/BlogThumb.astro";
import Byline from "../components/Byline.astro";
import HeroSplash from "../components/HeroSplash.astro";
import PostCard from "../components/PostCard.astro";
import PostTitle from "../components/PostTitle.astro";
import SubscribeBand from "../components/SubscribeBand.astro";
import TopicChips from "../components/TopicChips.astro";
import { getPosts, topicsOf } from "../lib/posts";
import { pageUrl } from "../lib/blog-path";
import { authorRole } from "../lib/byline";
import { shortDate } from "../lib/dates";

const posts = await getPosts();
const [featured, ...rest] = posts;
const side = rest.slice(0, 4);
// The grid holds every post so the topic chips can filter it in place;
// under "All" the ones already shown above stay hidden.
const heroCount = 1 + side.length;
const allTags = topicsOf(posts);
// A role line only fits a single author; co-written posts show just the time.
const featuredRole = featured?.authors.length === 1 ? authorRole(featured.authors[0]) : null;
---

<style>
	/* Visualization spans the hero as a background layer: barely-there
	   behind the heading, fully visible at the top right. */
	.hero-viz {
		mask-image: linear-gradient(
			97deg,
			rgba(0, 0, 0, 0.1) 0%,
			rgba(0, 0, 0, 0.16) 42%,
			rgba(0, 0, 0, 0.7) 64%,
			rgb(0, 0, 0) 85%
		);
		-webkit-mask-image: linear-gradient(
			97deg,
			rgba(0, 0, 0, 0.1) 0%,
			rgba(0, 0, 0, 0.16) 42%,
			rgba(0, 0, 0, 0.7) 64%,
			rgb(0, 0, 0) 85%
		);
	}
</style>

<Base
	title="Engineering Blog"
	description="Benchmarks, systems deep dives, and hard-won lessons from OpenTeams engineers."
	og="home"
>
	<section class="container-wide relative pt-11 pb-10">
		<div class="hero-viz pointer-events-none absolute inset-0 hidden md:block" aria-hidden="true">
			<HeroSplash />
		</div>
		<div class="relative z-10">
			<h1 class="max-w-[640px] text-3xl leading-[1.1] font-bold tracking-tight md:text-[38px]">
				Notes from the people who <span class="text-brand">build with open source</span>
			</h1>
			<p class="mt-3 max-w-[540px] text-base text-muted">
				Benchmarks, systems deep dives, and hard-won lessons from OpenTeams engineers.
			</p>
		</div>
	</section>

	{featured && (
		<section class="container-wide grid gap-10 pb-16 md:grid-cols-2">
			<div class="group relative transition-transform duration-200 hover:-translate-y-1">
				<a href={pageUrl(`/${featured.slug}`)} class="block after:absolute after:inset-0 after:content-['']">
					<BlogThumb slug={featured.slug} size="big" />
					<div class="cat-label mt-5">{featured.topic.label}</div>
					<h2 class="post-title-link mt-2.5 mb-2.5 text-2xl leading-[1.18] font-bold tracking-tight md:text-[28px]">
						<PostTitle parts={featured.titleParts} />
					</h2>
					{featured.excerpt && (
						<p class="max-w-[600px] text-[15.5px] leading-relaxed text-muted">
							{featured.excerpt}
						</p>
					)}
				</a>
				<Byline authors={featured.authors} size={32} class="mt-4 gap-2.5" nameClass="text-[13.5px] leading-tight font-semibold">
					<div class="text-xs leading-tight text-faint">
						{featuredRole && <>{featuredRole} &middot; </>}<time datetime={featured.date.toISOString()}>{shortDate(featured.date)}</time> &middot; {featured.minutes} min read
					</div>
				</Byline>
			</div>
			<div class="grid content-start gap-x-6 gap-y-9 sm:grid-cols-2">
				{side.map((p) => (
					<PostCard post={p} size="mini" />
				))}
			</div>
		</section>
	)}

	<div class="container-wide">
		<div class="flex flex-wrap items-baseline justify-between gap-4 border-t border-border pt-11 pb-8">
			<h2 id="grid-heading" class="text-[28px] font-bold tracking-tight">Latest articles</h2>
			{allTags.length > 0 && (
				<TopicChips topics={allTags} />
			)}
		</div>
		<div id="post-grid" class="grid gap-x-10 gap-y-11 pb-16 md:grid-cols-3">
			{posts.map((p, i) => (
				<div data-topic={p.topic.slug} data-hero={i < heroCount ? "" : undefined} hidden={i < heroCount}>
					<PostCard post={p} />
				</div>
			))}
		</div>
	</div>

	<SubscribeBand />
</Base>

<script>
	// Topic chips filter the grid without leaving the page. The chosen topic
	// lives in ?topic= so the view survives reloads and can be shared.
	const chips = document.querySelectorAll<HTMLAnchorElement>("nav[aria-label=Topics] a[data-topic]");
	const cards = document.querySelectorAll<HTMLElement>("#post-grid > [data-topic]");
	const heading = document.getElementById("grid-heading");

	function show(topic: string) {
		for (const card of cards) {
			card.hidden = topic ? card.dataset.topic !== topic : "hero" in card.dataset;
		}
		for (const chip of chips) {
			if (chip.dataset.topic === topic) {
				chip.setAttribute("aria-current", "page");
				if (heading) heading.textContent = topic ? chip.textContent!.trim() : "Latest articles";
			} else {
				chip.removeAttribute("aria-current");
			}
		}
	}

	for (const chip of chips) {
		chip.addEventListener("click", (e) => {
			// Let cmd/ctrl/shift-click open the tag page in a new tab as usual.
			if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
			e.preventDefault();
			const topic = chip.dataset.topic ?? "";
			const url = new URL(location.href);
			if (topic) url.searchParams.set("topic", topic);
			else url.searchParams.delete("topic");
			history.replaceState(null, "", url);
			show(topic);
		});
	}

	const initial = new URL(location.href).searchParams.get("topic");
	if (initial && [...chips].some((c) => c.dataset.topic === initial)) show(initial);
</script>
