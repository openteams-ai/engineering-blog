---
import { blogUrl } from "../lib/blog-path";
import BlogThumb from "./BlogThumb.astro";
import Avatar from "./Avatar.astro";
import type { Post } from "../lib/posts";

interface Props {
	post: Post;
	size?: "cell" | "mini";
}

const { post, size = "cell" } = Astro.props;
const author = post.authors[0]?.name ?? "OpenTeams Engineering";
const avatarUrl = post.authors[0]?.avatarUrl ?? null;
const label = post.topic?.label ?? "Engineering";
const href = blogUrl(`/${post.slug}`);
---

{size === "mini" ? (
	<a href={href} class="group block transition-transform duration-200 hover:-translate-y-1">
		<BlogThumb slug={post.slug} size="mini" />
		<div class="mt-4"><span class="cat-badge">{label}</span></div>
		<h3 class="post-title-link mt-2 text-[17px] leading-snug font-semibold tracking-tight">
			{post.title}
		</h3>
		<div class="mt-2.5 flex items-center gap-2 text-[12.5px] text-faint">
			<Avatar name={author} src={avatarUrl} size={20} />
			{author} &middot; {post.minutes} min read
		</div>
	</a>
) : (
	<a href={href} class="group block transition-transform duration-200 hover:-translate-y-1">
		<BlogThumb slug={post.slug} size="cell" />
		<div class="cat-label mt-4">{label}</div>
		<h3 class="post-title-link mt-2 mb-2 text-xl leading-snug font-semibold tracking-tight">
			{post.title}
		</h3>
		{post.excerpt && (
			<p class="line-clamp-2 text-[14.5px] leading-relaxed text-muted">{post.excerpt}</p>
		)}
		<div class="mt-3.5 flex items-center gap-2.5">
			<Avatar name={author} src={avatarUrl} size={30} />
			<div>
				<div class="text-[13px] leading-tight font-semibold">{author}</div>
				<div class="text-xs leading-tight text-faint">{post.minutes} min read</div>
			</div>
		</div>
	</a>
)}
