---
// A post in a grid. The whole card opens the post: the link's overlay covers
// the card, and only the byline's author links sit above it.
import { pageUrl } from "../lib/blog-path";
import BlogThumb from "./BlogThumb.astro";
import Byline from "./Byline.astro";
import PostTitle from "./PostTitle.astro";
import type { Post } from "../lib/posts";
import { shortDate } from "../lib/dates";

interface Props {
	post: Post;
	size?: "cell" | "mini";
}

const { post, size = "cell" } = Astro.props;
const label = post.topic.label;
const href = pageUrl(`/${post.slug}`);
const card = "group relative transition-transform duration-200 hover:-translate-y-1";
const over = "block after:absolute after:inset-0 after:content-['']";
---

{size === "mini" ? (
	<div class={card}>
		<a href={href} class={over}>
			<BlogThumb slug={post.slug} size="mini" />
			<div class="mt-4"><span class="cat-badge">{label}</span></div>
			<h3 class="post-title-link mt-2 text-[17px] leading-snug font-semibold tracking-tight">
				<PostTitle parts={post.titleParts} />
			</h3>
		</a>
		<Byline authors={post.authors} size={20} class="mt-2.5 gap-2 text-[12.5px] text-faint" nameClass="inline">
			<span>{" "}&middot; <time datetime={post.date.toISOString()}>{shortDate(post.date)}</time></span>
		</Byline>
	</div>
) : (
	<div class={card}>
		<a href={href} class={over}>
			<BlogThumb slug={post.slug} size="cell" />
			<div class="cat-label mt-4">{label}</div>
			<h3 class="post-title-link mt-2 mb-2 text-xl leading-snug font-semibold tracking-tight">
				<PostTitle parts={post.titleParts} />
			</h3>
			{post.excerpt && (
				<p class="line-clamp-2 text-[14.5px] leading-relaxed text-muted">{post.excerpt}</p>
			)}
		</a>
		<Byline authors={post.authors} size={30} class="mt-3.5 gap-2.5" nameClass="text-[13px] leading-tight font-semibold">
			<div class="text-xs leading-tight text-faint"><time datetime={post.date.toISOString()}>{shortDate(post.date)}</time> &middot; {post.minutes} min read</div>
		</Byline>
	</div>
)}
