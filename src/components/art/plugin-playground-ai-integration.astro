---
import { code, navy, softBlue, solidBlue, blueMut } from "./style";
---

<svg viewBox="0 0 720 380" class="h-full w-full" preserveAspectRatio="xMidYMid meet" role="img" aria-label="AI-drafted plugin code feeding the write, load, test, refine loop">
	<rect x="-300" y="-300" width="1320" height="980" fill={softBlue}/>
	<g font-family={code}>
		<rect x="60" y="64" width="290" height="230" rx="14" fill="#ffffff"/>
		<rect x="60" y="64" width="290" height="40" rx="14" fill="#e9f0fb"/>
		<rect x="60" y="90" width="290" height="14" fill="#e9f0fb"/>
		<circle cx="86" cy="84" r="5" fill="#9db8e8"/><circle cx="104" cy="84" r="5" fill="#9db8e8"/><circle cx="122" cy="84" r="5" fill="#9db8e8"/>
		<text x="205" y="90" text-anchor="middle" font-size="17" fill={blueMut}>plugin.ts</text>
		<rect x="84" y="122" width="200" height="14" rx="7" fill="#dbe7fa"/>
		<rect x="84" y="150" width="242" height="18" rx="6" fill="#c0e8d0"/>
		<rect x="84" y="176" width="242" height="18" rx="6" fill="#c0e8d0"/>
		<rect x="84" y="204" width="150" height="14" rx="7" fill="#dbe7fa"/>
		<rect x="200" y="244" width="128" height="36" rx="18" fill={solidBlue}/>
		<text x="264" y="268" text-anchor="middle" font-size="18" fill="#ffffff" font-weight="500">AI draft</text>
	</g>
	<g font-family={code} font-size="22">
		<path d="M540 108 A 82 82 0 1 1 458 190" fill="none" stroke={solidBlue} stroke-width="4"/>
		<path d="M450 172 L458 198 L477 182 Z" fill={solidBlue}/>
		<rect x="486" y="72" width="108" height="42" rx="21" fill="#ffffff"/>
		<text x="540" y="100" text-anchor="middle" fill={navy}>write</text>
		<rect x="586" y="169" width="98" height="42" rx="21" fill="#ffffff"/>
		<text x="635" y="197" text-anchor="middle" fill={navy}>load</text>
		<rect x="490" y="266" width="100" height="42" rx="21" fill="#ffffff"/>
		<text x="540" y="294" text-anchor="middle" fill={navy}>test</text>
		<rect x="384" y="169" width="120" height="42" rx="21" fill="#ffffff"/>
		<text x="444" y="197" text-anchor="middle" fill={navy}>refine</text>
	</g>
</svg>
