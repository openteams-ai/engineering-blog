---
import { plex, navy, peach, gold } from "./style";

// The lock was real; the key was the number 4. Three padlocks in a column,
// the middle one open, with a key reading "4" just beside it.
const W = 74, H = 56, x = 218, ys = [72, 184, 296], open = 1;
const cx = x + W / 2, ky = ys[open] + 22;
const tip = x + W + 24, shaft = 112, r = 40, bow = tip + shaft + r - 4;
---

<svg viewBox="0 0 720 380" class="h-full w-full" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Three padlocks in a column; the middle one is open, with a key labeled 4 beside it">
	<rect x="-300" y="-300" width="1320" height="980" fill={peach}/>
	{ys.map((y, i) => (
		<g opacity={i === open ? 1 : 0.35}>
			<path
				d={i === open
					? `M${x + 18} ${y} V${y - 24} A19 19 0 0 1 ${x + 56} ${y - 24} V${y - 12}`
					: `M${x + 18} ${y} V${y - 16} A19 19 0 0 1 ${x + 56} ${y - 16} V${y}`}
				fill="none" stroke={navy} stroke-width="12" stroke-linecap="round"/>
			<rect x={x} y={y} width={W} height={H} rx="11" fill={navy}/>
			<circle cx={cx} cy={y + 22} r="8" fill={peach}/>
			<rect x={cx - 4} y={y + 24} width="8" height="20" rx="3" fill={peach}/>
		</g>
	))}
	<!-- the key, pointing at the open lock -->
	<rect x={tip} y={ky - 6} width={shaft} height="12" rx="4" fill={gold}/>
	<rect x={tip + 8} y={ky + 5} width="11" height="16" rx="2" fill={gold}/>
	<rect x={tip + 27} y={ky + 5} width="11" height="10" rx="2" fill={gold}/>
	<circle cx={bow} cy={ky} r={r} fill={gold}/>
	<text x={bow} y={ky + 19} text-anchor="middle" font-family={plex} font-size="54" font-weight="700" fill={navy}>4</text>
</svg>
