const libs = [logos.pandas, logos.polars, logos.duckdb];
const bar = greenLine;
const card = { x: 56, w: 220, h: 76 };
const ys = [40, 128, 216];
const one = { x: 440, y: 76, w: 224, h: 200 };
---

<svg viewBox="0 0 720 380" class="h-full w-full" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Three separate functions, one each for pandas, Polars and DuckDB, become one Narwhals function">
	<rect x="-300" y="-300" width="1320" height="980" fill={lightGreen}/>

	<!-- before: one function per library -->
	{ys.map((y, i) => (
		<g>
			<rect x={card.x} y={y} width={card.w} height={card.h} rx="12" fill="#ffffff"/>
			<path transform={`translate(${card.x + 18} ${y + card.h / 2 - 18}) scale(1.5)`} fill={navy} d={libs[i]}/>
			<rect x={card.x + 76} y={y + 20} width="112" height="12" rx="6" fill={bar}/>
			<rect x={card.x + 76} y={y + 44} width={[80, 124, 96][i]} height="12" rx="6" fill={bar}/>
		</g>
	))}

	<!-- Narwhals arrow -->
	<text x="358" y="160" text-anchor="middle" font-family={plex} font-size="26" font-weight="700" fill={green}>Narwhals</text>
	<path d="M296 178 H410" stroke={green} stroke-width="5" stroke-linecap="round"/>
	<path d="M404 166 L424 178 L404 190 Z" fill={green}/>

	<!-- after: one function for all three -->
	<rect x={one.x} y={one.y} width={one.w} height={one.h} rx="14" fill="#ffffff" stroke={green} stroke-width="4"/>
	{libs.map((d, i) => <path transform={`translate(${one.x + 24 + i * 60} ${one.y + 22}) scale(1.5)`} fill={navy} d={d}/>)}
	{[[112, 0], [160, 1], [128, 1], [96, 0]].map(([w, indent], j) => (
		<rect x={one.x + 24 + indent * 24} y={one.y + 88 + j * 24} width={w} height="12" rx="6" fill={j === 1 ? green : bar}/>
	))}

	<g font-family={plex} font-size="26" font-weight="600" text-anchor="middle" fill={greenDeep}>
		<text x={card.x + card.w / 2} y="336">3 functions</text>
		<text x={one.x + one.w / 2} y="336">1 function</text>
	</g>
</svg>
