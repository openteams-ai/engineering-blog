---
import { plex, navy, peach, peachSoft, peachMid, gold, goldDeep } from "./style";

// Same screen from both approaches, with the token bill under each.
const builds = [
	{ x: 70, name: "registry", tokens: "186k tokens", bar: 110 },
	{ x: 430, name: "skill + kit", tokens: "380k tokens", bar: 220 },
];
---

<svg viewBox="0 0 720 380" class="h-full w-full" preserveAspectRatio="xMidYMid meet" role="img" aria-label="The registry and the skill and kit build the same screen, but the skill and kit use 380k tokens against the registry's 186k">
	<rect x="-300" y="-300" width="1320" height="980" fill={peach}/>
	{builds.map((b) => (
		<g transform={`translate(${b.x} 44)`}>
			<rect width="220" height="160" rx="14" fill="#ffffff"/>
			<rect x="14" y="16" width="44" height="128" rx="8" fill={peachSoft}/>
			<rect x="22" y="28" width="28" height="9" rx="4.5" fill={gold}/>
			<rect x="22" y="46" width="28" height="9" rx="4.5" fill={peachMid}/>
			<rect x="22" y="64" width="20" height="9" rx="4.5" fill={peachMid}/>
			<rect x="72" y="18" width="120" height="10" rx="5" fill={peachMid}/>
			<rect x="72" y="36" width="84" height="10" rx="5" fill={peachSoft}/>
			{[
				{ x: 76, h: 34 },
				{ x: 104, h: 56 },
				{ x: 132, h: 42 },
				{ x: 160, h: 70, hot: true },
			].map((c) => (
				<rect x={c.x} y={140 - c.h} width="20" height={c.h} rx="5" fill={c.hot ? gold : peachMid}/>
			))}
		</g>
	))}
	<g stroke={navy} stroke-width="6" stroke-linecap="round">
		<path d="M340 114 H380"/>
		<path d="M340 134 H380"/>
	</g>
	<g font-family={plex} text-anchor="middle">
		{builds.map((b) => (
			<>
				<text x={b.x + 110} y="248" font-size="28" font-weight="600" fill={navy}>{b.name}</text>
				<rect x={b.x} y="272" width="220" height="16" rx="8" fill={peachSoft}/>
				<rect x={b.x} y="272" width={b.bar} height="16" rx="8" fill={gold}/>
				<text x={b.x + 110} y="330" font-size="28" font-weight="600" fill={goldDeep}>{b.tokens}</text>
			</>
		))}
	</g>
</svg>
