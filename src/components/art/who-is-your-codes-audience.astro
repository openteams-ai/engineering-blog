---
import { plex, lightGreen, green, greenDeep, greenWash, greenLine, greenDot } from "./style";
---

<svg viewBox="0 0 720 380" class="h-full w-full" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Code written by AI, read by humans">
	<rect x="-300" y="-300" width="1320" height="980" fill={lightGreen}/>
	<g font-family={plex}>
		<rect x="190" y="44" width="340" height="190" rx="14" fill="#ffffff"/>
		<rect x="190" y="44" width="340" height="38" rx="14" fill={greenWash}/>
		<rect x="190" y="68" width="340" height="14" fill={greenWash}/>
		<circle cx="214" cy="63" r="5" fill={greenDot}/><circle cx="232" cy="63" r="5" fill={greenDot}/><circle cx="250" cy="63" r="5" fill={greenDot}/>
		<rect x="216" y="104" width="200" height="14" rx="7" fill={greenLine}/>
		<rect x="240" y="132" width="240" height="14" rx="7" fill={greenLine}/>
		<rect x="240" y="160" width="170" height="14" rx="7" fill={greenLine}/>
		<rect x="216" y="188" width="220" height="14" rx="7" fill={greenLine}/>
		<g font-size="24">
			<rect x="110" y="272" width="230" height="52" rx="26" fill="#ffffff"/>
			<text x="225" y="306" text-anchor="middle" fill={green}>written by AI</text>
			<path d="M352 298 H396" stroke={greenDeep} stroke-width="4" stroke-linecap="round"/>
			<path d="M390 287 L408 298 L390 309 Z" fill={greenDeep}/>
			<rect x="420" y="272" width="250" height="52" rx="26" fill={green}/>
			<text x="545" y="306" text-anchor="middle" fill="#ffffff" font-weight="600">read by humans</text>
		</g>
	</g>
</svg>
