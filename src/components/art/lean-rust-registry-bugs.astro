---
import { plex, navy, softBlue, solidBlue, blueMut } from "./style";
---

<svg viewBox="0 0 720 380" class="h-full w-full" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Confirmed bugs: Lean proofs found 1, tests found 14">
	<rect x="-300" y="-300" width="1320" height="980" fill={softBlue}/>
	<g font-family={plex}>
		<text x="90" y="152" font-size="30" fill={navy} font-weight="500">Lean</text>
		<rect x="200" y="120" width="30" height="46" rx="12" fill={solidBlue}/>
		<text x="246" y="153" font-size="30" fill={solidBlue} font-weight="600">1</text>
		<text x="90" y="250" font-size="30" fill={navy} font-weight="500">Tests</text>
		<rect x="200" y="218" width="420" height="46" rx="12" fill="#ffffff"/>
		<text x="596" y="251" text-anchor="end" font-size="30" fill={blueMut} font-weight="600">14</text>
	</g>
</svg>
