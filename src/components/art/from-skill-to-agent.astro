---
import { code, navy, softBlue, blueMut } from "./style";
---

<svg viewBox="0 0 720 380" class="h-full w-full" preserveAspectRatio="xMidYMid meet" role="img" aria-label="A skill markdown file growing into a running agent loop">
	<rect x="-300" y="-300" width="1320" height="980" fill={softBlue}/>
	<g font-family={code}>
		<path d="M100 60 h130 l40 40 v170 h-170 Z" fill="#ffffff"/>
		<path d="M230 60 v40 h40" fill="none" stroke="#9db8e8" stroke-width="2.5"/>
		<text x="122" y="130" font-size="24" fill={navy} font-weight="500">SKILL.md</text>
		<rect x="122" y="156" width="110" height="12" rx="6" fill="#dbe7fa"/>
		<rect x="122" y="182" width="126" height="12" rx="6" fill="#dbe7fa"/>
		<rect x="122" y="208" width="92" height="12" rx="6" fill="#dbe7fa"/>
		<text x="185" y="330" text-anchor="middle" font-size="22" fill={blueMut}>a text file</text>
		<path d="M300 180 H384" stroke={navy} stroke-width="4" stroke-linecap="round"/>
		<path d="M376 169 L394 180 L376 191 Z" fill={navy}/>
		<rect x="420" y="66" width="250" height="188" rx="14" fill="#1e1e2e"/>
		<circle cx="446" cy="92" r="5" fill="#45475a"/><circle cx="464" cy="92" r="5" fill="#45475a"/><circle cx="482" cy="92" r="5" fill="#45475a"/>
		<text x="442" y="142" font-size="20" fill="#cba6f7">while task:</text>
		<text x="442" y="178" font-size="20" fill="#cdd6f4">&#160;plan -&gt; act</text>
		<text x="442" y="214" font-size="20" fill="#a6e3a1">&#160;&#10003; keeps state</text>
		<text x="545" y="330" text-anchor="middle" font-size="22" fill={blueMut}>an agent</text>
	</g>
</svg>
