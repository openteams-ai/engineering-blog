---
import { blogUrl } from "../lib/blog-path";
// Command-palette search ported from the Darby theme: pill trigger with a
// distinct Cmd+K chip, fixed overlay modal, Fuse.js fuzzy search over
// the blog's search-index.json, arrow/enter keyboard navigation,
// and "Suggested pages" on empty open.
---

<button class="search-trigger" data-search-trigger type="button" aria-label="Search">
	<svg width="16" height="16" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
	<span>Search...</span><kbd><span class="kbd-cmd">&#8984;</span>K</kbd>
</button>

<div class="search-modal" id="search-modal" hidden>
	<div class="search-box" role="dialog" aria-modal="true" aria-label="Search">
		<div class="search-field">
			<svg class="search-field-icon" width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none"><circle cx="11" cy="11" r="7"></circle><path d="m21 21-4.3-4.3"></path></svg>
			<input type="search" class="search-input" data-search-input placeholder="Search articles..." autocomplete="off" aria-label="Search articles" />
			<button type="button" class="search-close" data-search-close aria-label="Close search"><svg width="16" height="16" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 6 6 18M6 6l12 12"></path></svg></button>
		</div>
		<ul class="search-results" data-search-results role="listbox"></ul>
		<div class="search-foot">
			<span><kbd>&uarr;</kbd><kbd>&darr;</kbd> navigate</span>
			<span><kbd>&crarr;</kbd> select</span>
			<span><kbd>esc</kbd> close</span>
		</div>
	</div>
</div>

<script is:inline src={blogUrl("/js/vendor/fuse.min.js")} defer></script>
<script is:inline define:vars={{ searchIndexUrl: blogUrl("/search-index.json") }}>
	// Ported from Darby assets/js/search.js (fuse backend only).
	(function () {
		function init() {
			var trigger = document.querySelector("[data-search-trigger]");
			var modal = document.getElementById("search-modal");
			var input = document.querySelector("[data-search-input]");
			var results = document.querySelector("[data-search-results]");
			var closeBtn = document.querySelector("[data-search-close]");
			if (!trigger || !modal) return;
			var fuse = null, ready = false, allData = [];
			var current = [];
			var active = -1;

			async function open() {
				modal.hidden = false;
				input.focus();
				if (!input.value.trim()) {
					try { await ensureFuse(); suggest(); } catch (e) { /* index unavailable */ }
				}
			}
			function close() { modal.hidden = true; input.value = ""; results.innerHTML = ""; current = []; active = -1; }
			trigger.addEventListener("click", open);
			if (closeBtn) closeBtn.addEventListener("click", close);
			modal.addEventListener("click", function (e) { if (e.target === modal) close(); });

			function esc(s) {
				return String(s).replace(/[&<>"']/g, function (c) {
					return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
				});
			}

			function highlight(value, indices) {
				if (!indices || !indices.length) return esc(value);
				var sorted = indices.slice().sort(function (a, b) { return a[0] - b[0]; });
				var out = "", last = 0;
				sorted.forEach(function (r) {
					var i0 = r[0], i1 = r[1] + 1;
					if (i0 < last) return;
					out += esc(value.slice(last, i0)) + "<mark>" + esc(value.slice(i0, i1)) + "</mark>";
					last = i1;
				});
				return out + esc(value.slice(last));
			}

			function rowHTML(it, i) {
				return '<li role="option" class="search-result' + (i === 0 ? " active" : "") + '" data-idx="' + i + '">' +
					'<a href="' + esc(it.url) + '" tabindex="-1">' +
						'<span class="sr-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/></svg></span>' +
						'<span class="sr-text">' +
							'<span class="sr-title">' + (it.titleHTML || esc(it.title)) + "</span>" +
							(it.section ? '<span class="sr-crumb">' + esc(it.section) + "</span>" : "") +
						"</span>" +
						'<span class="sr-enter" aria-hidden="true">&crarr;</span>' +
					"</a></li>";
			}

			function render(items) {
				current = items;
				active = items.length ? 0 : -1;
				if (!items.length) { results.innerHTML = '<li class="search-note">No results</li>'; return; }
				results.innerHTML = items.map(rowHTML).join("");
			}

			function suggest() {
				var items = allData.slice(0, 6).map(function (d) {
					return { titleHTML: esc(d.title), section: d.section, url: d.url };
				});
				current = items;
				active = items.length ? 0 : -1;
				results.innerHTML = '<li class="search-section-label">Suggested pages</li>' + items.map(rowHTML).join("");
			}

			function setActive(i) {
				var rows = results.querySelectorAll(".search-result");
				if (!rows.length) return;
				active = (i + rows.length) % rows.length;
				rows.forEach(function (r, idx) { r.classList.toggle("active", idx === active); });
				rows[active].scrollIntoView({ block: "nearest" });
			}

			document.addEventListener("keydown", function (e) {
				if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); open(); return; }
				if (modal.hidden) return;
				if (e.key === "Escape") { close(); }
				else if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
				else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
				else if (e.key === "Enter" && active >= 0 && current[active]) { window.location.href = current[active].url; }
			});
			results.addEventListener("mousemove", function (e) {
				var li = e.target.closest(".search-result");
				if (li) setActive(parseInt(li.getAttribute("data-idx"), 10));
			});

			async function ensureFuse() {
				if (ready) return;
				var res = await fetch(searchIndexUrl);
				if (!res.ok) throw new Error("search index not found (" + res.status + ")");
				var data = await res.json();
				allData = data;
				// @ts-ignore -- Fuse is a global from the vendored script tag above.
				fuse = new Fuse(data, {
					keys: [{ name: "title", weight: 3 }, { name: "section", weight: 1 }, { name: "content", weight: 1 }],
					threshold: 0.35, ignoreLocation: true, includeMatches: true, minMatchCharLength: 2,
				});
				ready = true;
			}

			function note(msg) { current = []; active = -1; results.innerHTML = '<li class="search-note">' + esc(msg) + "</li>"; }

			input.addEventListener("input", async function () {
				var q = input.value.trim();
				if (!q) { if (ready) { suggest(); } else { results.innerHTML = ""; current = []; active = -1; } return; }
				try {
					await ensureFuse();
					var hits = fuse.search(q).slice(0, 8);
					if (!hits.length) { note("No results"); return; }
					render(hits.map(function (h) {
						var tm = (h.matches || []).filter(function (m) { return m.key === "title"; })[0];
						return { titleHTML: highlight(h.item.title, tm ? tm.indices : null), section: h.item.section, url: h.item.url };
					}));
				} catch (e) {
					note("Search is unavailable");
				}
			});
		}
		if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
		else init();
	})();
</script>

<style is:global>
	.search-trigger { display: inline-flex; align-items: center; gap: 0.5rem; width: auto; min-width: 12rem; height: 2.4rem; background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-muted); border-radius: 999px; padding: 0 0.45rem 0 0.85rem; cursor: pointer; font-size: 0.85rem; font-family: var(--font-header); transition: color 0.15s ease, border-color 0.15s ease; }
	.search-trigger:hover { border-color: var(--color-brand); color: var(--color-text); }
	.search-trigger > span { font-weight: 500; }
	.search-trigger kbd { margin-left: auto; display: inline-flex; align-items: center; gap: 0.2em; font-family: var(--font-mono); font-size: 0.72rem; color: var(--color-muted); line-height: 1; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 999px; padding: 0.2rem 0.5rem; }
	.search-trigger kbd .kbd-cmd { font-size: 1.2em; line-height: 1; }

	.search-modal { position: fixed; inset: 0; background: rgba(4, 20, 55, 0.45); display: grid; place-items: start center; padding-top: 12vh; z-index: 200; }
	.search-modal[hidden] { display: none; }
	.search-box { width: min(40rem, 92vw); background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 16px; box-shadow: 0 16px 48px rgba(2, 20, 55, 0.25); overflow: hidden; display: flex; flex-direction: column; max-height: 70vh; }
	.search-field { display: flex; align-items: center; gap: 0.65rem; padding: 0.85rem 1rem; border-bottom: 1px solid var(--color-border); }
	.search-field-icon { color: var(--color-muted); flex: none; }
	.search-input { flex: 1; border: 0; background: transparent; color: var(--color-text); font-size: 1.05rem; font-family: var(--font-header); outline: none; min-width: 0; appearance: none; -webkit-appearance: none; }
	.search-input:focus, .search-input:focus-visible { outline: none; box-shadow: none; }
	.search-input::-webkit-search-decoration, .search-input::-webkit-search-cancel-button { -webkit-appearance: none; }
	.search-close { flex: none; display: inline-flex; background: none; border: 0; color: var(--color-muted); cursor: pointer; padding: 0.25rem; border-radius: 8px; }
	.search-close:hover { color: var(--color-text); background: var(--color-surface); }
	.search-results { list-style: none; margin: 0; padding: 0.4rem; overflow-y: auto; flex: 1; scrollbar-width: thin; }
	.search-result a { display: flex; align-items: center; gap: 0.7rem; padding: 0.6rem 0.7rem; border-radius: 10px; color: var(--color-text); text-decoration: none; }
	.search-result.active { background: var(--color-surface); border-radius: 10px; }
	.sr-icon { color: var(--color-muted); flex: none; display: inline-flex; }
	.sr-text { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; flex: 1; }
	.sr-title { font-weight: 600; color: var(--color-text); font-size: 0.95rem; font-family: var(--font-header); }
	.sr-crumb { font-size: 0.78rem; color: var(--color-muted); font-family: var(--font-header); }
	.sr-enter { flex: none; align-self: center; font-size: 1.05rem; opacity: 0; color: var(--color-muted); }
	.search-result.active .sr-enter { opacity: 1; }
	.search-results mark { background: transparent; color: var(--color-brand); font-weight: 700; }
	.search-section-label { padding: 0.55rem 0.7rem 0.2rem; color: var(--color-faint); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; font-family: var(--font-header); }
	.search-note { padding: 0.55rem 0.7rem; color: var(--color-muted); font-size: 0.9rem; }
	.search-foot { display: flex; gap: 1rem; padding: 0.5rem 0.9rem; border-top: 1px solid var(--color-border); font-size: 0.72rem; color: var(--color-muted); font-family: var(--font-header); }
	.search-foot kbd { font-family: var(--font-mono); border: 1px solid var(--color-border); border-radius: 4px; padding: 0 0.3rem; margin-right: 0.15rem; }

	@media (max-width: 960px) {
		.search-trigger span, .search-trigger kbd { display: none; }
		.search-trigger { padding: 0.4rem; width: auto; min-width: 0; background: none; border: none; }
	}
</style>
