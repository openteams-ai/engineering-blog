---
import { blogUrl } from "../lib/blog-path";
// Horizontal subscribe call-to-action: navy band with a short pitch and an
// RSS button. Rendered below the article grid on the index and below every
// post. RSS is the honest subscribe target until a newsletter backend exists.
---

<section class="container-wide pb-20">
	<div class="bg-deep flex flex-col items-start justify-between gap-6 rounded-2xl px-8 py-9 md:flex-row md:items-center md:px-12">
		<div>
			<h2 class="text-2xl font-bold tracking-tight text-white">Never miss a post</h2>
			<p class="mt-1.5 max-w-[520px] text-[15px] text-[#97a3c4]">
				Benchmarks, deep dives, and lessons from OpenTeams engineers, straight to your feed reader.
			</p>
		</div>
		<a
			href={blogUrl("/rss.xml")}
			class="inline-flex shrink-0 items-center gap-2.5 rounded-full bg-white px-6 py-3 text-[15px] font-semibold text-[#041437] transition-transform duration-200 hover:-translate-y-0.5"
		>
			<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
				<path d="M4 11a9 9 0 0 1 9 9" />
				<path d="M4 4a16 16 0 0 1 16 16" />
				<circle cx="5.5" cy="18.5" r="1.4" fill="currentColor" stroke="none" />
			</svg>
			Subscribe via RSS
		</a>
	</div>
</section>
