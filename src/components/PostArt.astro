		<g fill="none" stroke={navy} stroke-width="2.5">
			<circle cx="360" cy="40" r="11"/>
			<circle cx="128" cy="236" r="12"/>
			<circle cx="612" cy="292" r="9"/>
		</g>
		<image href={blogUrl("/blog-logos/jupyter.svg")} x={hub.x - 84} y={hub.y - 120} width="168" height="222"/>
		<g fill={orange}>
			<path d={sparkle(196, 104, 30)}/>
			<path d={sparkle(560, 128, 24)}/>
			<path d={sparkle(118, 318, 16)}/>
		</g>
		<g fill={navy}>
			<path d={sparkle(482, 70, 13)}/>
			<circle cx="250" cy="330" r="4.5"/>
			<circle cx="490" cy="336" r="4.5"/>
			<circle cx="226" cy="190" r="4.5"/>
			<circle cx="626" cy="196" r="4.5"/>
		</g>
	</svg>
)}

{slug === "jev-bench-package-curation" && (
	<svg viewBox="0 0 720 380" class="h-full w-full" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Latency per decision: Jev 136 ms, a fine-tuned Laya 21 ms">
		<rect x="-300" y="-300" width="1320" height="980" fill={lime}/>
		<g font-family={mono}>
			<text x="110" y="152" font-size="28" fill={navy} font-weight="600">Jev</text>
			<rect x="220" y="122" width="408" height="44" rx="12" fill="#ffffff"/>
			<text x="604" y="153" text-anchor="end" font-size="26" fill={green}>136 ms</text>
			<text x="110" y="246" font-size="28" fill={navy} font-weight="600">Laya</text>
			<rect x="220" y="216" width="63" height="44" rx="12" fill={greenDeep}/>
			<text x="300" y="247" font-size="28" fill={greenDeep} font-weight="700">21 ms</text>
		</g>
	</svg>
)}

{slug === "minicpm5-2b-quantization-report" && (
	<svg viewBox="0 0 720 380" class="h-full w-full" preserveAspectRatio="xMidYMid meet" role="img" aria-label="MiniCPM5-2B in 3 GiB">
		<rect x="-300" y="-300" width="1320" height="980" fill={softBlue}/>
		<rect x="90" y="110" width="300" height="160" rx="24" fill="#fdfdfd"/>
		<image href={blogUrl("/blog-logos/minicpm.png")} x="112" y="130" width="256" height="120"/>
		<g font-family={mono}>
			<text x="430" y="210" font-size="76" fill={navy} font-weight="700">3 GiB</text>
			<text x="434" y="252" font-size="24" fill={blueMut}>of RAM</text>
		</g>
	</svg>
)}

{slug === "llm-review-reliability" && (
	<svg viewBox="0 0 720 380" class="h-full w-full" preserveAspectRatio="xMidYMid meet" role="img" aria-label="The best reviewer caught 10 of 12 unsupported claims">
		<rect x="-300" y="-300" width="1320" height="980" fill={solidBlue}/>
		{Array.from({ length: 12 }, (_, i) => (
			<circle cx={130 + (i % 6) * 56} cy={i < 6 ? 150 : 214} r="20" fill="#ffffff" opacity={i < 10 ? 1 : 0.28}/>
		))}
		<g font-family={mono}>
			<text x="490" y="202" font-size="64" fill="#ffffff" font-weight="700">10/12</text>
			<text x="494" y="242" font-size="24" fill="#cfe1fb">caught</text>
		</g>
	</svg>
)}

{slug === "intelligence-vs-cost" && (
	<svg viewBox="0 0 720 380" class="h-full w-full" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Fable 5.1 at $3.69 per task against GLM-5.3-Flash at $0.023">
		<rect x="-300" y="-300" width="1320" height="980" fill={cream}/>
		<image href={blogUrl("/blog-logos/claude.svg")} x="150" y="96" width="96" height="96"/>
		<image href={blogUrl("/blog-logos/zai.svg")} x="474" y="100" width="88" height="88"/>
		<g font-family={mono} text-anchor="middle">
			<text x="198" y="262" font-size="44" fill={navy} font-weight="700">$3.69</text>
			<text x="360" y="160" font-size="26" fill={creamMut}>vs</text>
			<text x="518" y="262" font-size="44" fill={orange} font-weight="700">$0.023</text>
		</g>
	</svg>
)}
