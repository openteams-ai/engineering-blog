---
// Hand-made minimal headline art, one vignette per post. Every label and
// number comes from the post itself. All draw in a 720x380 viewBox and
// scale to any card size. Labels render in IBM Plex Sans (--font-header).
//
// Color system (Atlassian-style, restrained): four background families
// rotate across the cards -- soft blue tint, lime tint, cream tint, solid
// brand blue -- plus dark navy. Each tint carries dark ink of its OWN hue,
// and success checks are one green everywhere.
//
// Legibility rule: cards render as small as ~230px wide (a third of the
// canvas), so shapes carry each vignette and text is scarce and LARGE --
// nothing under ~17px on the canvas, key labels 22-36px.
interface Props {
	slug: string;
}

import { blogUrl } from "../lib/blog-path";

const { slug } = Astro.props;
const mono = "var(--font-header)"; // IBM Plex Sans, same as the nav
const navy = "#091e42";
const mut = "#5d6575";
// background families
const softBlue = "#d6e4fa";
const lime = "#d3f1a7";
const cream = "#fff0c2";
const solidBlue = "#1d6ae5";
const darkNavy = "#041437";
// inks
const blueMut = "#44546f";
const green = "#216e4e";
const greenDeep = "#164b35";
const creamMut = "#7f5f01";
const orange = "#d97008";
const check = "#22a06b";

// Jupyter in orbit: the logo at the centre, three sparkles for
// extensions, and a few dots and rings around it.
const hub = { x: 360, y: 200 };
const sparkle = (x: number, y: number, r: number) =>
	`M${x} ${y - r}Q${x} ${y} ${x + r} ${y}Q${x} ${y} ${x} ${y + r}Q${x} ${y} ${x - r} ${y}Q${x} ${y} ${x} ${y - r}Z`;
---

