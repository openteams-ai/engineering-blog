		<rect x="-300" y="-300" width="1320" height="980" fill={darkNavy}/>
		<rect x="110" y="120" width="140" height="140" rx="32" fill="#ffffff"/>
		<image href={blogUrl("/blog-logos/eslint.svg")} x="140" y="150" width="80" height="80"/>
		<g font-family={mono}>
			<rect x="310" y="126" width="300" height="56" rx="28" fill="#ff8f73" opacity="0.16"/>
			<text x="340" y="163" font-size="26" fill="#ff8f73" font-weight="600">&#10005; lint error</text>
			<rect x="310" y="198" width="300" height="56" rx="28" fill="#7fd4a3" opacity="0.16"/>
			<text x="340" y="235" font-size="26" fill="#7fd4a3" font-weight="600">&#10003; fixed by agent</text>
		</g>
	</svg>
)}

